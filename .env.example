NODE_ENV=development
SERVICE_NAME=tixwar-api
PORT=3000
LOG_LEVEL=info
BODY_LIMIT=100kb
CORS_ORIGINS=http://localhost:3000,http://localhost:8080

MONGODB_URI=mongodb://mongos:27017/tixwar?retryWrites=true&w=majority
MONGODB_DATABASE=tixwar
MONGODB_READ_PREFERENCE=primary
MONGODB_MAX_POOL_SIZE=50
MONGODB_MIN_POOL_SIZE=5
MONGODB_MAX_CONNECTING=10
MONGODB_WAIT_QUEUE_TIMEOUT_MS=10000
MONGODB_SERVER_SELECTION_TIMEOUT_MS=5000
MONGODB_SOCKET_TIMEOUT_MS=10000
MONGODB_CONNECT_TIMEOUT_MS=5000
MONGODB_WRITE_CONCERN=majority

REDIS_URL=redis://redis:6379/0

JWT_ACCESS_SECRET=replace-with-long-random-access-secret
JWT_REFRESH_SECRET=replace-with-long-random-refresh-secret
JWT_ACCESS_TTL=15m
JWT_REFRESH_TTL=7d
JWT_ISSUER=tixwar

RATE_LIMIT_ANON=120
RATE_LIMIT_GLOBAL=300
RATE_LIMIT_LOGIN=5
RATE_LIMIT_LOGIN_LOCKOUT_FAILURES=10
RATE_LIMIT_LOGIN_LOCKOUT_SECONDS=900
RATE_LIMIT_ORDER_USER=3
RATE_LIMIT_ORDER_IP=30
RATE_LIMIT_PAY_USER=5

ORDER_TTL_SECONDS=600
STOCK_PREWARM_MINUTES=5
STOCK_RECONCILE_SECONDS=60
MAX_PAYMENT_ATTEMPTS=3

CACHE_LIST_TTL_SECONDS=30
CACHE_DETAIL_TTL_SECONDS=60
CACHE_NEGATIVE_TTL_SECONDS=10

GATEWAY_URL=http://mock-gateway:4000
GATEWAY_TIMEOUT_MS=2000
BREAKER_ERROR_THRESHOLD_PERCENT=50
BREAKER_VOLUME_THRESHOLD=10
BREAKER_RESET_TIMEOUT_MS=20000

SMTP_URL=smtp://mailpit:1025
SMTP_TIMEOUT_MS=3000
MAIL_FROM=TixWar <no-reply@tixwar.local>

MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_USE_SSL=false
MINIO_ACCESS_KEY=replace-me
MINIO_SECRET_KEY=replace-me
MINIO_BUCKET=tixwar-tickets
MINIO_PRESIGN_TTL_SECONDS=300

DEBUG_ENABLED=false
DEBUG_ADMIN_TOKEN=replace-with-debug-admin-token

OTEL_EXPORTER_OTLP_ENDPOINT=http://jaeger:4318
OTEL_SERVICE_NAME=tixwar
SENTRY_DSN=
METRICS_PORT=9464
TRACE_TTL_DAYS=30
TRACE_CHANNEL=trace

WEBHOOK_TIMEOUT_MS=5000
WEBHOOK_MAX_ATTEMPTS=5
WEBHOOK_ALLOW_HTTP=true
WEBHOOK_ALLOW_PRIVATE_NETWORK=true

QUEUE_PREFIX=tixwar
OUTBOX_POLL_INTERVAL_MS=250
OUTBOX_BATCH_SIZE=50
OUTBOX_LEASE_MS=30000
OUTBOX_MAX_ATTEMPTS=5
WORKER_CONCURRENCY_ORDER=10
WORKER_CONCURRENCY_PAYMENT=10
WORKER_CONCURRENCY_NOTIFICATION=20
WORKER_CONCURRENCY_WEBHOOK=10
WORKER_CONCURRENCY_EXPIRY=10
