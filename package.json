{
  "name": "tixwar",
  "version": "0.1.0",
  "private": true,
  "type": "module",
  "description": "TixWar — flash sale ticketing API (backend only)",
  "scripts": {
    "dev": "bun --watch src/server.ts",
    "start": "bun src/server.ts",
    "worker": "bun src/worker.ts",
    "outbox": "bun src/outbox-publisher.ts",
    "gateway": "bun src/mock-gateway/server.ts",
    "check": "biome check . && tsc --noEmit",
    "check:fix": "biome check --write .",
    "test": "bun test tests/unit",
    "test:integration": "bun test tests/integration",
    "test:all": "bun test tests",
    "migrate": "bun scripts/migrate.ts",
    "seed": "bun scripts/seed.ts",
    "dlq": "bun scripts/dlq.ts",
    "rebuild-stock": "bun scripts/rebuild-stock.ts",
    "reshard": "bun scripts/reshard.ts",
    "gen-tokens": "bun scripts/gen-tokens.ts",
    "verify-sharding": "bun scripts/verify-sharding.ts",
    "api:types": "bun scripts/gen-api-types.ts",
    "prepare": "husky"
  },
  "dependencies": {
    "@opentelemetry/auto-instrumentations-node": "^0.83.1",
    "@opentelemetry/exporter-trace-otlp-http": "^0.301.2",
    "@opentelemetry/sdk-node": "^0.301.2",
    "@sentry/bun": "^11.12.0",
    "bullmq": "^6.7.6",
    "compression": "^1.8.2",
    "cors": "^2.8.6",
    "express": "^5.3.0",
    "helmet": "^8.3.0",
    "ioredis": "^6.0.0",
    "jose": "^6.2.17",
    "minio": "^8.0.7",
    "mongodb": "^7.9.0",
    "nodemailer": "^10.5.0",
    "opossum": "^10.0.0",
    "pino": "^10.4.0",
    "pino-http": "^11.0.0",
    "pino-pretty": "^13.2.0",
    "prom-client": "^15.1.3",
    "rate-limiter-flexible": "^11.4.1",
    "swagger-ui-express": "^5.0.1",
    "ulid": "^3.0.2",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@biomejs/biome": "^2.6.7",
    "@faker-js/faker": "^10.6.0",
    "@types/compression": "^1.8.1",
    "@types/cors": "^2.8.19",
    "@types/express": "^5.0.6",
    "@types/nodemailer": "^8.0.2",
    "@types/opossum": "^8.1.9",
    "@types/swagger-ui-express": "^4.1.8",
    "bun-types": "^1.4.4",
    "husky": "^9.1.7",
    "lint-staged": "^17.6.0",
    "migrate-mongo": "^14.0.7",
    "typescript": "^7.0.2"
  },
  "lint-staged": {
    "*.{ts,js,json}": [
      "biome check --write"
    ]
  }
}
