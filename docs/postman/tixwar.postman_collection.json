{
  "info": {
    "name": "TixWar API",
    "description": "Koleksi request TixWar: auth, events, orders, pay, SSE, API key.",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json"
  },
  "variable": [
    { "key": "baseUrl", "value": "http://localhost:8080" },
    { "key": "accessToken", "value": "" },
    { "key": "refreshToken", "value": "" },
    { "key": "eventId", "value": "" },
    { "key": "tierId", "value": "" },
    { "key": "orderId", "value": "" },
    { "key": "apiKeyId", "value": "" }
  ],
  "item": [
    {
      "name": "auth",
      "item": [
        {
          "name": "register",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"demo@tixwar.local\",\n  \"password\": \"Demo-Password-2024\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/register",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "register"]
            }
          }
        },
        {
          "name": "login",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "const body = pm.response.json();",
                  "pm.collectionVariables.set('accessToken', body.data.accessToken);",
                  "pm.collectionVariables.set('refreshToken', body.data.refreshToken);"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"email\": \"admin@tixwar.local\",\n  \"password\": \"TixWar-Admin-2024\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/login",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "login"]
            }
          }
        },
        {
          "name": "refresh",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/refresh",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "refresh"]
            }
          }
        },
        {
          "name": "logout",
          "request": {
            "method": "POST",
            "header": [{ "key": "Content-Type", "value": "application/json" }],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"refreshToken\": \"{{refreshToken}}\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/auth/logout",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "auth", "logout"]
            }
          }
        }
      ]
    },
    {
      "name": "events",
      "item": [
        {
          "name": "list events",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/events?limit=20&city=jakarta&sort=-startsAt",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"],
              "query": [
                { "key": "limit", "value": "20" },
                { "key": "city", "value": "jakarta" },
                { "key": "sort", "value": "-startsAt" }
              ]
            }
          }
        },
        {
          "name": "event detail (ETag)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}?include=tiers",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events", "{{eventId}}"],
              "query": [{ "key": "include", "value": "tiers" }]
            }
          }
        },
        {
          "name": "create event (admin)",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"name\": \"Demo Concert\",\n  \"description\": \"Flash sale demo event\",\n  \"category\": \"music\",\n  \"city\": \"jakarta\",\n  \"venue\": \"Main Hall\",\n  \"startsAt\": \"2026-12-01T19:00:00.000Z\",\n  \"status\": \"SCHEDULED\"\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/events",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events"]
            }
          }
        },
        {
          "name": "event stock stream (SSE)",
          "request": {
            "method": "GET",
            "url": {
              "raw": "{{baseUrl}}/v1/events/{{eventId}}/stream",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "events", "{{eventId}}", "stream"]
            }
          }
        }
      ]
    },
    {
      "name": "orders",
      "item": [
        {
          "name": "create order",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('orderId', pm.response.json().data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Idempotency-Key", "value": "demo-order-{{$guid}}" }
            ],
            "body": {
              "mode": "raw",
              "raw": "{\n  \"tierId\": \"{{tierId}}\",\n  \"quantity\": 1\n}"
            },
            "url": {
              "raw": "{{baseUrl}}/v1/orders",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders"]
            }
          }
        },
        {
          "name": "list own orders",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/orders?limit=20",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders"],
              "query": [{ "key": "limit", "value": "20" }]
            }
          }
        },
        {
          "name": "order detail",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{orderId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders", "{{orderId}}"]
            }
          }
        },
        {
          "name": "pay order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" },
              { "key": "Idempotency-Key", "value": "demo-pay-{{$guid}}" }
            ],
            "body": { "mode": "raw", "raw": "{}" },
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{orderId}}/pay",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders", "{{orderId}}", "pay"]
            }
          }
        },
        {
          "name": "cancel order",
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"reason\": \"changed my mind\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{orderId}}/cancel",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders", "{{orderId}}", "cancel"]
            }
          }
        },
        {
          "name": "order status stream (SSE)",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/orders/{{orderId}}/stream",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "orders", "{{orderId}}", "stream"]
            }
          }
        }
      ]
    },
    {
      "name": "tickets",
      "item": [
        {
          "name": "list own tickets",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/tickets",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "tickets"]
            }
          }
        }
      ]
    },
    {
      "name": "api-keys",
      "item": [
        {
          "name": "create API key",
          "event": [
            {
              "listen": "test",
              "script": {
                "exec": [
                  "if (pm.response.code === 201) {",
                  "  pm.collectionVariables.set('apiKeyId', pm.response.json().data.id);",
                  "}"
                ],
                "type": "text/javascript"
              }
            }
          ],
          "request": {
            "method": "POST",
            "header": [
              { "key": "Content-Type", "value": "application/json" },
              { "key": "Authorization", "value": "Bearer {{accessToken}}" }
            ],
            "body": { "mode": "raw", "raw": "{\n  \"name\": \"demo-client\"\n}" },
            "url": {
              "raw": "{{baseUrl}}/v1/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "api-keys"]
            }
          }
        },
        {
          "name": "list API keys",
          "request": {
            "method": "GET",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/api-keys",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "api-keys"]
            }
          }
        },
        {
          "name": "revoke API key",
          "request": {
            "method": "DELETE",
            "header": [{ "key": "Authorization", "value": "Bearer {{accessToken}}" }],
            "url": {
              "raw": "{{baseUrl}}/v1/api-keys/{{apiKeyId}}",
              "host": ["{{baseUrl}}"],
              "path": ["v1", "api-keys", "{{apiKeyId}}"]
            }
          }
        }
      ]
    }
  ]
}
